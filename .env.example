# Node.js 22.18+ 或 24.12+，首次运行需要 npm install
HOST=127.0.0.1
PORT=3080
# Docker 后台端口绑定地址；外网访问设为 0.0.0.0，NapCat 接口仍仅绑定本机
BOT_BIND=127.0.0.1
# 留空时首次打开后台自定义管理员账号和密码（密码至少 8 位）。
# 仅兼容旧版脚本预置：填写此项时使用旧版账号名，已有账号始终保持不变。
ADMIN_PASSWORD=
DATA_DIR=./data
# 空闲时定时回收机器人 JS 堆，单位分钟；0 关闭额外的定时 GC。
GC_INTERVAL_MINUTES=15
# HTTPS 反向代理部署时设置 true，使用 Secure Cookie
COOKIE_SECURE=false
# HTTPS 代理部署时填真实外部地址，用于同源校验，例如 https://bot.example.com
PUBLIC_ORIGIN=
# 可选：用于加密存储平台解析 Cookie 的主密钥
DATA_ENCRYPTION_KEY=
