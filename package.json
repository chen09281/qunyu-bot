{
  "name": "qq-deepseek-bot",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "支持群聊 @ 与白名单私聊的 DeepSeek 机器人，附带管理后台",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "build": "vite build",
    "prestart": "npm run build",
    "start": "node --expose-gc --env-file-if-exists=.env src/server.mjs",
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --expose-gc --env-file-if-exists=.env --watch src/server.mjs",
    "deploy": "node --env-file-if-exists=.env src/deploy.mjs",
    "deploy:ubuntu": "bash ubuntu.sh deploy",
    "package:ubuntu": "node scripts/package-ubuntu.mjs",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.mjs\"",
    "reset-password": "node --env-file-if-exists=.env src/reset-password.mjs",
    "backup": "node --env-file-if-exists=.env src/backup.mjs backup",
    "restore": "node --env-file-if-exists=.env src/backup.mjs restore",
    "start:prebuilt": "node --expose-gc --env-file-if-exists=.env src/server.mjs",
    "prepackage:delivery": "npm run build",
    "package:delivery": "node scripts/package-delivery.mjs",
    "export:opensource": "node scripts/export-opensource.mjs",
    "prepackage:ubuntu": "npm run build"
  },
  "dependencies": {
    "nodemailer": "10.3.1",
    "qrcode": "^1.5.4",
    "rss-parser": "3.13.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "fsevents": false
  }
}
