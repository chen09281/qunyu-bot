# Ubuntu 专用配置，不读取旧的 .env，避免旧 BOT_BIND 覆盖公网端口。
# 初次部署时 ubuntu.sh 会自动复制本文件为 .env.ubuntu，之后修改该文件。
UBUNTU_BIND=0.0.0.0
UBUNTU_PORT=3080
# 与旧版本相同的 data 目录可直接保留；路径含空格时加双引号。
UBUNTU_DATA_DIR=./data
# 空闲时定时回收机器人 JS 堆，单位分钟；0 关闭额外的定时 GC。
GC_INTERVAL_MINUTES=15
# 可选：只由服务器管理员配置的自建 RSSHub；保持空白时使用后台的公网地址。
# 与 compose.rsshub.yaml 共用 Docker 网络后可设置 http://rsshub:1200。
RSSHUB_INTERNAL_URL=
# 容器使用固定普通用户；切换 sudo/SSH 用户不会改变数据所有者。
UBUNTU_UID=1000
UBUNTU_GID=1000
# 留空：首次打开后台设置管理员账号和密码；已有账号保持不变。
# 仅兼容旧版预置密码脚本，交付安装建议保持留空。
UBUNTU_ADMIN_PASSWORD=
# HTTP 访问保持 false；配置 HTTPS 代理后改为 true。
UBUNTU_COOKIE_SECURE=false
UBUNTU_PUBLIC_ORIGIN=
# 镜像拉取失败时先检查服务器 DNS / Docker 镜像源，勿填写不可信的镜像地址。
UBUNTU_NODE_IMAGE=node:24-alpine
# 可选的 Alpine 软件源，例如 https://mirrors.aliyun.com/alpine；留空使用官方源。
UBUNTU_ALPINE_MIRROR=
# 可单独指定浏览器依赖源，不必重建已缓存的 Python / FFmpeg 依赖层。
UBUNTU_CHROMIUM_ALPINE_MIRROR=
# Python 依赖源；国内服务器可改为 https://mirrors.aliyun.com/pypi/simple/。
UBUNTU_PIP_INDEX_URL=https://pypi.org/simple
UBUNTU_NAPCAT_IMAGE=mlikiowa/napcat-docker:v4.18.42
# 可选：用于加密存储平台解析 Cookie 的主密钥
# 修改后需重新创建机器人容器；已有明文 Cookie 需重新保存或扫码才会加密。
# 请单独保管此密钥，迁移时沿用；签到凭据使用 data/checkin/key，不使用此变量。
DATA_ENCRYPTION_KEY=
